#!/bin/bash

# This file is `source`'d before calling `buildkite-agent pipeline upload`, and can be used
# to set up some variables that will be interpolated in the `.yml` pipeline before uploading it.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

XCODE_VERSION_FILE="$SCRIPT_DIR/../.xcode-version"
if [[ ! -s "$XCODE_VERSION_FILE" ]]; then
    echo "Error: '$XCODE_VERSION_FILE' not found or empty." >&2
    exit 1
fi
XCODE_VERSION=$(sed -E 's/^~> *//' "$XCODE_VERSION_FILE")

CI_TOOLKIT_PLUGIN_VERSION="6.3.0"
TEST_COLLECTOR_PLUGIN_VERSION="1.11.0"

# Decided here, at pipeline upload, so that no Mac agent boots just to find there is nothing to run.
# PR builds run the Ruby Automation Tests only when `fastlane/` changed; other builds (trunk,
# release branches) always run them. If the check fails or prints anything but true/false, run the
# tests: the value is interpolated into an `if:`, where anything else would fail the upload.
# Other steps source this file without the CI toolkit, so only check when `pr_changed_files` exists.
RUN_RUBY_AUTOMATION_TESTS=true
if [[ "${BUILDKITE_PULL_REQUEST:-false}" =~ ^[0-9]+$ ]] && command -v pr_changed_files >/dev/null; then
    FASTLANE_CHANGED=$(pr_changed_files --stdout --any-match 'fastlane/**') || FASTLANE_CHANGED=''
    if [[ "$FASTLANE_CHANGED" == true || "$FASTLANE_CHANGED" == false ]]; then
        RUN_RUBY_AUTOMATION_TESTS=$FASTLANE_CHANGED
    else
        echo "-> pr_changed_files returned '$FASTLANE_CHANGED'; running the Ruby Automation Tests" >&2
    fi
fi
echo "-> Should run Ruby Automation Tests: $RUN_RUBY_AUTOMATION_TESTS"

export RUN_RUBY_AUTOMATION_TESTS
export IMAGE_ID="xcode-$XCODE_VERSION"
export CI_TOOLKIT="automattic/a8c-ci-toolkit#$CI_TOOLKIT_PLUGIN_VERSION"
export TEST_COLLECTOR="test-collector#v$TEST_COLLECTOR_PLUGIN_VERSION"
export CLAUDE_PLUGIN="iangmaia/claude-summarize#ce99c67dd57cdf236c3daca82b86a335fd5e9cc2"
