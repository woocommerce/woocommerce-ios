#!/bin/bash

# This file is `source`'d before calling `buildkite-agent pipeline upload`, and can be used
# to set up some variables that will be interpolated in the `.yml` pipeline before uploading it.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

XCODE_VERSION_FILE="$SCRIPT_DIR/../.xcode-version"
if [[ ! -s "$XCODE_VERSION_FILE" ]]; then
    echo "Error: '$XCODE_VERSION_FILE' not found or empty." >&2
    exit 1
fi
XCODE_VERSION=$(sed -E 's/^~> *//' "$XCODE_VERSION_FILE")

CI_TOOLKIT_PLUGIN_VERSION="7.3.0"
TEST_COLLECTOR_PLUGIN_VERSION="1.11.0"

export IMAGE_ID="xcode-$XCODE_VERSION"
export CI_TOOLKIT="automattic/a8c-ci-toolkit#$CI_TOOLKIT_PLUGIN_VERSION"
export TEST_COLLECTOR="test-collector#v$TEST_COLLECTOR_PLUGIN_VERSION"
export CLAUDE_PLUGIN="iangmaia/claude-summarize#ce99c67dd57cdf236c3daca82b86a335fd5e9cc2"

# Skip decisions, made here on the upload agent so that skipped jobs never wait for a Mac.
# One variable per job type: `false` runs the step, anything else is the reason to skip it. The pipeline uses them as `skip: "$SKIP_…"`.
# Only where `pr_changed_files` (from the a8c-ci-toolkit plugin) is available, like the pipeline upload step: other steps that source this file don't need them.
if command -v pr_changed_files >/dev/null 2>&1; then
    for job_type in build validation localization; do
        skip_var="SKIP_$(echo "$job_type" | tr 'a-z-' 'A-Z_')"
        export "$skip_var=$("$SCRIPT_DIR/commands/should-skip-job.sh" "$job_type")"
        echo "$skip_var=${!skip_var}"
    done
fi
