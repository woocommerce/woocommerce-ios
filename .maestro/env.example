# Setup:
#   1. Copy this file: cp .maestro/env.example .maestro/.env.local
#   2. Choose credentials for either a test store listed in the smoke-testing
#      P2 or your own suitable test store.
#   3. Fill in the values required by the flows you plan to run.
#
# This public example intentionally provides no test-store URLs or credentials.
# Each developer is responsible for obtaining or providing suitable test-store
# credentials and adding them only to .maestro/.env.local or CI secrets.
# NEVER commit filled-in credentials. .env.local is git-ignored.
# Quote values containing whitespace or shell metacharacters, including `)`.

# Jetpack-connected live test store using WordPress.com authentication.
# Extended smoke coverage requires this store to be eligible for Inbox.
MAESTRO_WOO_LAB_JETPACK_STORE_URL=
MAESTRO_WOO_LAB_WPCOM_EMAIL=
MAESTRO_WOO_LAB_WPCOM_PASSWORD=

# WooCommerce site without Jetpack, using site-admin credentials. A trailing
# /wp-admin or /wp-admin/ in the supplied URL is removed by the runner.
MAESTRO_WOO_NO_JETPACK_SITE_URL=
MAESTRO_WOO_NO_JETPACK_SITE_ADMIN_USERNAME=
MAESTRO_WOO_NO_JETPACK_SITE_ADMIN_PASSWORD=

# Not-Woo-store fixture. Site-admin credentials are required.
MAESTRO_WOO_NOT_A_WOO_STORE_URL=
MAESTRO_WOO_NOT_A_WOO_STORE_SITE_ADMIN_USERNAME=
MAESTRO_WOO_NOT_A_WOO_STORE_SITE_ADMIN_PASSWORD=
# Required for wordpress.com-hosted fixtures; optional for self-hosted sites.
# Set both values or leave both blank.
MAESTRO_WOO_NOT_A_WOO_STORE_WPCOM_EMAIL=
MAESTRO_WOO_NOT_A_WOO_STORE_WPCOM_PASSWORD=

# Dedicated negative-login fixture.
MAESTRO_WOO_WRONG_ACCOUNT_STORE_URL=

# Optional. Required only with explicit --seed or cleanup tooling.
MAESTRO_WOO_CONSUMER_KEY=
MAESTRO_WOO_CONSUMER_SECRET=

# Optional flow-specific data. Values must belong to the configured iOS store.
MAESTRO_WOO_TEST_COUPON_CODE=
MAESTRO_WOO_TEST_RECEIPT_EMAIL=

# Required by the complete destructive order-creation assertion. Use the
# dedicated synthetic customer's exact email address for the search value.
MAESTRO_WOO_EXISTING_CUSTOMER_SEARCH=
