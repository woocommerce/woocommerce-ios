{
  "document": {
    "type": "document",
    "children": [
      {
        "type": "text",
        "content": "{storeName}",
        "style": {
          "fontSize": 20,
          "bold": true,
          "alignment": "center"
        }
      },
      {
        "type": "text",
        "content": "Date: {date}",
        "style": {
          "fontSize": 14,
          "alignment": "left"
        }
      },
      {
        "type": "text",
        "content": "Amount Paid: {amountPaid}",
        "style": {
          "fontSize": 16,
          "bold": true,
          "alignment": "left"
        }
      },
      {
        "type": "text",
        "content": "Card: **** **** **** {cardLast4}",
        "style": {
          "fontSize": 14,
          "alignment": "left"
        }
      },
      {
        "type": "line",
        "style": {
          "thickness": 1
        }
      },
      {
        "type": "list",
        "items": [
          {
            "type": "text",
            "content": "{title} x {quantity}    {amount}",
            "style": {
              "fontSize": 14,
              "alignment": "left"
            }
          }
        ]
      },
      {
        "type": "line",
        "style": {
          "thickness": 1
        }
      },
      {
        "type": "list",
        "items": [
          {
            "type": "text",
            "content": "{totalDescription}: {totalAmount}",
            "style": {
              "fontSize": 16,
              "bold": true,
              "alignment": "left"
            }
          }
        ]
      },
      {
        "type": "text",
        "content": "{orderNote}",
        "style": {
          "fontSize": 12,
          "italic": true,
          "alignment": "left"
        }
      },
      {
        "type": "cut",
        "style": {
          "type": "partial"
        }
      }
    ]
  }
}
